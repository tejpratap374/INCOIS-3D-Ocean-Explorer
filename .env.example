# Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Data directories
DATA_DIR=./data
SAMPLE_DIR=./data/sample
METADATA_DIR=./data/metadata
MODEL_DB_DIR=./data/model_db
# Explicit path to a real ocean-model NetCDF file. When set, it takes
# precedence over any cached snapshot under MODEL_DB_DIR.
# OCEAN_DATA_FILE=/path/to/real_ocean_model.nc

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Auth (demo — NOT for production)
ENABLE_AUTH=false
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Data policy — this project NEVER fabricates ocean data.
# Missing caches return HTTP 503 DATA_NOT_AVAILABLE.
# Set ERDDAP_USE_LIVE=1 to fetch Argo/Glider positions live from ERDDAP
# instead of the mirrored GDAC GeoJSON cache.
ERDDAP_USE_LIVE=0

# Cache
CACHE_TTL_SECONDS=300
MAX_SUBGRID_POINTS=250000

# Optional
# DATABASE_URL=sqlite:///./data/ocean.db
# REDIS_URL=redis://localhost:6379